+void
+zink_texture_handle_unref(struct zink_screen *screen, struct zink_bindless_descriptor *bd)
+{
+   if (!p_atomic_dec_zero(&bd->texture_refcount))
+      return;
+   simple_mtx_lock(&screen->texture_handles.lock);
+   uint32_t slot = bd->handle;
+   if (bd->ds.is_buffer) slot -= ZINK_MAX_BINDLESS_HANDLES;
+   util_idalloc_free(&screen->texture_handles.table[bd->ds.is_buffer].slots, slot);
+   simple_mtx_unlock(&screen->texture_handles.lock);
+   if (bd->sampler) {
+      VKSCR(DestroySampler)(screen->dev, bd->sampler->sampler, NULL);
+      if (bd->sampler->sampler_clamped)
+         VKSCR(DestroySampler)(screen->dev, bd->sampler->sampler_clamped, NULL);
+      if (bd->sampler->custom_border_color)
+         p_atomic_dec(&screen->cur_custom_border_color_samplers);
+      free(bd->sampler);
