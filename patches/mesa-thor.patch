+   if (bd->ds.is_buffer)
+      zink_buffer_view_reference(screen, &bd->ds.bufferview, NULL);
+   else
+      zink_surface_reference(screen, &bd->ds.surface, NULL);
+   pipe_resource_reference(&bd->texture_resource, NULL);
+   free(bd);
